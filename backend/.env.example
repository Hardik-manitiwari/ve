# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Replica Set URI (required for MongoDB multi-document transactions)
MONGO_URI=mongodb://localhost:27017/veloop_wallet?replicaSet=rs0

# JWT Auth Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here!
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:5173

# Default Passwords for Seed Users
DEMO_PASSWORD=DemoPassword123!
ADMIN_PASSWORD=AdminPassword123!
